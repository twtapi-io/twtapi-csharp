<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Twtapi</RootNamespace>
    <AssemblyName>Twtapi</AssemblyName>

    <!-- NuGet metadata -->
    <PackageId>Twtapi</PackageId>
    <Version>0.1.0</Version>
    <Authors>twtapi.io</Authors>
    <Company>twtapi.io</Company>
    <Description>Official .NET client for the twtapi.io HTTP API.</Description>
    <PackageProjectUrl>https://github.com/twtapi-io/twtapi-csharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/twtapi-io/twtapi-csharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>twitter;x;twtapi;sdk;api-client</PackageTags>

    <!-- Docs + symbols + source link -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>
</Project>
